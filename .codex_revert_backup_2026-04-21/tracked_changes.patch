+  bool _isTruthyFlag(dynamic value, {bool fallback = false}) {
+    if (value == null) return fallback;
+    if (value is bool) return value;
+    if (value is num) return value == 1 || value == 1.0;
+    final normalized = value.toString().trim().toLowerCase();
+    if (normalized.isEmpty) return fallback;
+    if (normalized == "1" ||
+        normalized == "true" ||
+        normalized == "yes" ||
+        normalized == "y" ||
+        normalized == "on") {
+      return true;
+    }
+    if (normalized == "0" ||
+        normalized == "false" ||
+        normalized == "no" ||
+        normalized == "n" ||
+        normalized == "off") {
+      return false;
+    }
+    final parsed = num.tryParse(normalized);
+    if (parsed != null) {
+      return parsed == 1 || parsed == 1.0;
+    }
+    return fallback;
+  }
+
+  bool _isCategoryActive(Map<String, dynamic> category) {
+    final raw =
+        category["is_active"] ?? category["isActive"] ?? category["active"];
+    return _isTruthyFlag(raw, fallback: true);
+  }
+
+  void _normalizeCategoryState(Map<String, dynamic> category) {
+    final isActive = _isCategoryActive(category);
+    category["is_active"] = isActive ? 1 : 0;
+    category["isActive"] = isActive ? 1 : 0;
+    category["active"] = isActive ? 1 : 0;
+  }
+
+  Future<void> _loadCategoryOverrides() async {
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      final raw = prefs.getString(_categoryOverridesKey);
+      _categoryOverrides.clear();
+      if (raw == null || raw.isEmpty) return;
+      final decoded = jsonDecode(raw);
+      if (decoded is! Map) return;
+      decoded.forEach((key, value) {
+        final id = int.tryParse(key.toString());
+        if (id == null || value is! Map) return;
+        _categoryOverrides[id] = Map<String, dynamic>.from(value as Map);
+      });
+    } catch (_) {}
+  }
+
+  void _applyCategoryOverride(Map<String, dynamic> category) {
+    final catId = _categoryId(category);
+    if (catId == null) {
+      _normalizeCategoryState(category);
+      return;
+    }
+    final override = _categoryOverrides[catId];
+    if (override != null) {
+      category.addAll(override);
+    }
+    _normalizeCategoryState(category);
+  }
