+    final status = response.statusCode ?? 0;
+    if (status >= 200 && status < 300) return;
+
+    final data = response.data;
+    String message = fallbackMessage ?? "Request failed";
+    if (data is Map) {
+      final apiMessage =
+          data["message"] ?? data["error"] ?? data["errors"]?.toString();
+      if (apiMessage != null && apiMessage.toString().trim().isNotEmpty) {
+        message = apiMessage.toString().trim();
+      }
+    } else if (data != null && data.toString().trim().isNotEmpty) {
+      message = data.toString().trim();
+    }
+
+    throw Exception(message);
+  }
